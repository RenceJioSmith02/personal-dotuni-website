<div class="chat-container" id="chat-container" style="display: none;">
    <div class="headersssss">
        <div class="title">
            <img src="~/Content/chatbotasset/dodotgif.gif" alt="DoDOT" class="profilepicssss">
            <span style="letter-spacing: .2rem">DoDOT</span>
        </div>
       <div class="btnsssss">
