                </svg>
            </a>
            <a id="minimize_chat" title="Minimize">
                <i class="bi bi-dash-circle-fill"></i>
            </a>
            <a id="close_chat" title="Close">
                <i class="bi bi-x-circle-fill"></i>
            </a>
        </div>

    </div>
    <div id="chatbox" role="main">
        <div id="messages"></div>
        <div class="input_box">
            <textarea id="user-input" placeholder="Type your message..." rows="1"></textarea>
            <button id="send-button">Send</button>
        </div>
    </div>
</div>

<button class="float" id="chatbutton"></button>
<div class="label-container">
    <div class="label-text">
        <img src="~/Content/chatbotasset/dodotchatbubbles.png" alt="DoDOT" class="hoverimage">
    </div>

</div>

<script src="~/Content/chatbotasset/assets/js/bundle.js?ver=3.1.2"></script>
